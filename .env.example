# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is gitignored. Never commit a real key.

# ---------------------------------------------------------------------------
# Required for the default (cloud) setup
# ---------------------------------------------------------------------------
# Used for vision, for optional LLM-phrased nudges, and for text-to-speech.
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Where the models run
# ---------------------------------------------------------------------------
# cloud = OpenAI (default; the only option that works on a Reachy Mini wireless)
# edge  = local models via MLX. macOS on Apple Silicon ONLY.
FOCUS_BUDDY_BACKEND=cloud

# ---------------------------------------------------------------------------
# How nudges are spoken
# ---------------------------------------------------------------------------
# openai = OpenAI text-to-speech (default; works everywhere, needs a key)
# macos  = the built-in `say` command. Offline and free, macOS only.
# none   = stay silent and only log nudges
FOCUS_BUDDY_SPEECH=openai
# FOCUS_BUDDY_TTS_VOICE=alloy

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Seconds between camera checks.
# FOCUS_BUDDY_POLL_INTERVAL_S=1
# Minimum quiet time between two spoken nudges.
# FOCUS_BUDDY_NUDGE_COOLDOWN_S=60
# How often to speak the running daily summary.
# FOCUS_BUDDY_SUMMARY_EVERY_S=3600
# Let a language model rephrase nudges instead of using fixed templates.
# Off by default: templates are instant, free, and never say anything strange.
# FOCUS_BUDDY_USE_LLM_NUDGES=false

# ---------------------------------------------------------------------------
# Models (override only if you know why)
# ---------------------------------------------------------------------------
# FOCUS_BUDDY_CLOUD_VISION_MODEL=gpt-4o-mini
# FOCUS_BUDDY_CLOUD_LLM_MODEL=gpt-4o-mini
# FOCUS_BUDDY_TTS_MODEL=gpt-4o-mini-tts
# FOCUS_BUDDY_EDGE_VISION_MODEL=smdesai/SmolVLM2-2.2B-Instruct-4bit
# FOCUS_BUDDY_EDGE_LLM_MODEL=mlx-community/Llama-3.2-1B-Instruct-4bit

# ---------------------------------------------------------------------------
# Debugging
# ---------------------------------------------------------------------------
# Write the exact crop the edge vision model saw, to check framing.
# FOCUS_BUDDY_DEBUG_FRAME=debug/frame.jpg
# Keep the multi-gigabyte model cache out of your home directory.
# HF_HOME=./cache
